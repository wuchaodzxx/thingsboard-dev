# =====================================================================
# 环境变量模板（复制为 .env 后按需修改；.env 含本机个性化配置，勿入代码仓库）
#   cp .env.example .env
# =====================================================================

# ThingsBoard 镜像（固定版本，升级须重新确认）
TB_IMAGE=thingsboard/tb-postgres:3.5.1

# ---- 对外端口（1xxxx，避免与主机服务冲突）----
# TB Web UI / REST API（容器内 9090）
TB_HTTP_PORT=18080
# MQTT over TLS（容器内 8883）
# 注：本机 18883 已被既有服务占用，故选用 18885；部署前请确认端口空闲
MQTTS_PORT=18885
# MQTT 明文调试端口（仅 docker-compose.debug-mqtt.yml 生效，容器内 1883）
MQTT_DEBUG_PORT=18886

# 时区（影响容器与 TB 日志时间戳）
TZ=Asia/Shanghai

# JVM 内存（按宿主机资源调整，建议容器可用内存 >= 4GB 时用默认值）
JAVA_OPTS=-Xms512m -Xmx1536m

# ---- MQTT TLS（P3 起默认启用，X.509 双向认证）----
# 启用 MQTTS 8883；证书由 certmgr 签发：certmgr issue-server --out ../deploy/certs/server
MQTT_SSL_ENABLED=true
# 服务器凭据类型：PEM
MQTT_SSL_CREDENTIALS_TYPE=PEM
# 服务器证书/私钥在容器内的路径（compose 只读挂载 ./certs/server -> /certs/server）
MQTT_SSL_PEM_CERT=/certs/server/server-fullchain.pem
MQTT_SSL_PEM_KEY=/certs/server/server_key.pem
