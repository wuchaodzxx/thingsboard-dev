{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shared-attributes.schema.json",
  "title": "M08 共享属性下发（平台→设备，配置语义）",
  "type": "object",
  "required": ["cfgVer"],
  "properties": {
    "cfgVer": { "type": "integer", "minimum": 1, "maximum": 4294967295, "description": "配置版本，单调递增" },
    "hbPeriodSec": { "type": "integer", "minimum": 10, "maximum": 300, "default": 30 },
    "tele1mEnable": { "type": "boolean", "default": true },
    "tele15mEnable": { "type": "boolean", "default": true },
    "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] }
  },
  "additionalProperties": true,
  "description": "设备整体原子校验：全部合法才应用；应用后回报客户端属性 {cfgVerApplied, cfgApplyTs, cfgResult}"
}
