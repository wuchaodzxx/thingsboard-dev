{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "attributes-devinfo.schema.json",
  "title": "M01 设备信息上报（客户端属性）",
  "type": "object",
  "required": ["devSn", "devName", "devType", "devModel", "swVer", "protocolVer", "capKw"],
  "properties": {
    "devSn": { "type": "string", "maxLength": 32 },
    "devName": { "type": "string", "maxLength": 32, "description": "须与证书CN及TB设备名一致" },
    "devType": { "$ref": "_common.schema.json#/definitions/devType" },
    "devModel": { "type": "string", "maxLength": 32 },
    "vendor": { "type": "string", "maxLength": 32 },
    "swVer": { "type": "string", "maxLength": 16 },
    "hwVer": { "type": "string", "maxLength": 16 },
    "protocolVer": { "type": "string", "const": "vpp-1.0" },
    "capKw": { "type": "number", "exclusiveMinimum": 0, "description": "额定容量kW" },
    "loadType": { "$ref": "_common.schema.json#/definitions/loadType", "description": "devType=load 时必填，其余类型不适用" },
    "firstBootTs": { "$ref": "_common.schema.json#/definitions/tsMs" }
  },
  "additionalProperties": true
}
